@startuml
title eVoto - Diagrama de casos de uso
left to right direction
skinparam packageStyle rectangle

actor Eleitor
actor Administrador
actor "Sistema\n(temporizador)" as Sistema

rectangle eVoto {
  usecase "UC01 Autenticar eleitor\n(NIF + código)" as UC01
  usecase "Gerar código de acesso" as UC01a
  usecase "Validar código de acesso" as UC01b
  usecase "UC02 Autenticar administrador\n(email + palavra-passe)" as UC02
  usecase "UC03 Terminar sessão" as UC03

  usecase "UC04 Consultar as minhas eleições" as UC04
  usecase "UC05 Votar" as UC05
  usecase "Confirmar voto" as UC05a
  usecase "UC06 Consultar resultados\n(eleições apuradas)" as UC06

  usecase "UC07 Gerir eleições" as UC07
  usecase "UC08 Gerir cargos, listas\ne candidatos" as UC08
  usecase "UC09 Gerir recenseamento" as UC09
  usecase "UC10 Alterar estado / apurar\n(Hondt)" as UC10
  usecase "UC11 Gerir eleitores" as UC11
  usecase "UC12 Consultar painel (dashboards)" as UC12
  usecase "UC13 Consultar auditoria\ne autenticações" as UC13
  usecase "Abrir/encerrar eleições\npor calendário" as UC14
}

Eleitor --> UC01
Eleitor --> UC04
Eleitor --> UC05
Eleitor --> UC06
Eleitor --> UC03

Administrador --> UC02
Administrador --> UC07
Administrador --> UC10
Administrador --> UC11
Administrador --> UC12
Administrador --> UC13
Administrador --> UC03

Sistema --> UC14

UC01 ..> UC01a : <<include>>
UC01 ..> UC01b : <<include>>
UC04 ..> UC01 : <<include>>
UC05 ..> UC01 : <<include>>
UC06 ..> UC01 : <<include>>
UC05 ..> UC05a : <<include>>
UC07 ..> UC02 : <<include>>
UC10 ..> UC02 : <<include>>
UC11 ..> UC02 : <<include>>
UC12 ..> UC02 : <<include>>
UC13 ..> UC02 : <<include>>
UC08 ..> UC07 : <<extend>>
UC09 ..> UC07 : <<extend>>
UC14 ..> UC10 : <<include>>
@enduml
